.friends-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F5F5F5;
}

.search-bar {
  background: #FFFFFF;
  padding: 16rpx 24rpx;
}

.search-input-wrap {
  background: #F5F5F5;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  gap: 12rpx;
}

.search-icon { font-size: 28rpx; }

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.level-filter {
  background: #FFFFFF;
  white-space: nowrap;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.level-chip {
  display: inline-block;
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666666;
  background: #F5F5F5;
  margin-right: 12rpx;
  font-weight: 500;
}

.level-chip.active {
  background: #00B96B;
  color: #FFFFFF;
  font-weight: 700;
}

.player-list {
  flex: 1;
  overflow: hidden;
  padding-top: 10rpx;
}

.player-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 20rpx 24rpx;
  padding: 24rpx;
}

.player-left {
  position: relative;
}

.player-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #E0E0E0;
}

.verified-dot {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 32rpx;
  height: 32rpx;
  background: #00B96B;
  border-radius: 50%;
  color: #FFFFFF;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #FFFFFF;
}

.player-top { }

.player-name { font-size: 30rpx; }

.level-badge {
  font-size: 20rpx;
  font-weight: 700;
  color: #FFFFFF;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.credit-chip {
  font-size: 24rpx;
  font-weight: 600;
}

.player-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.meta-dot { color: #CCCCCC; }

.player-bio {
  display: block;
  margin-top: 8rpx;
}
