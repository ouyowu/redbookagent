.create-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F5F5F5;
}

.form-scroll {
  flex: 1;
  overflow: hidden;
}

.form-section {
  background: #FFFFFF;
  margin: 20rpx 0;
  padding: 10rpx 30rpx 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #999999;
  padding: 20rpx 0 10rpx;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  font-size: 24rpx;
}

.form-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.form-item:last-child { border-bottom: none; }

.form-label {
  display: block;
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 12rpx;
}

.form-label.required::before {
  content: '* ';
  color: #F44336;
}

.form-input {
  font-size: 30rpx;
  color: #333333;
  width: 100%;
  height: 60rpx;
  line-height: 60rpx;
}

.picker-value {
  font-size: 30rpx;
  color: #333333;
  height: 60rpx;
  line-height: 60rpx;
}

.picker-value.placeholder {
  color: #CCCCCC;
}

.form-row {
  display: flex;
  align-items: flex-end;
  gap: 10rpx;
}

.time-sep {
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
}

.fee-input-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.fee-prefix {
  font-size: 32rpx;
  color: #F44336;
  font-weight: 700;
}

.fee-input {
  width: 200rpx;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  color: #333333;
  margin-top: 10rpx;
  line-height: 1.6;
}

/* 信用提示 */
.credit-notice {
  margin: 10rpx 24rpx;
  background: #FFF3E0;
  border-radius: 12rpx;
  padding: 20rpx;
  display: flex;
  gap: 10rpx;
  align-items: flex-start;
}

.notice-icon { font-size: 28rpx; }

.notice-text {
  font-size: 24rpx;
  color: #E65100;
  line-height: 1.6;
  flex: 1;
}

/* 提交按钮 */
.submit-bar {
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #F0F0F0;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #00B96B, #00875A);
  color: #FFFFFF;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 700;
  border: none;
  letter-spacing: 2rpx;
}

.submit-btn::after { border: none; }
