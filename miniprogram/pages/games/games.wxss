.games-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F5F5F5;
  position: relative;
}

/* 筛选栏 */
.filter-bar {
  background: #FFFFFF;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #F0F0F0;
  position: sticky;
  top: 0;
  z-index: 100;
}

.status-tabs {
  flex: 1;
  white-space: nowrap;
  padding: 0 10rpx;
}

.status-tab {
  display: inline-block;
  padding: 24rpx 20rpx;
  font-size: 28rpx;
  color: #999999;
  position: relative;
}

.status-tab.active {
  color: #00B96B;
  font-weight: 600;
}

.status-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #00B96B;
  border-radius: 4rpx;
}

.level-picker { padding: 0 20rpx; }

.picker-btn {
  font-size: 26rpx;
  color: #666666;
  background: #F5F5F5;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  white-space: nowrap;
}

/* 球局列表 */
.game-list {
  flex: 1;
  overflow: hidden;
  padding-top: 10rpx;
}

/* 球局卡片 */
.game-card {
  margin: 20rpx 24rpx;
}

.game-header { align-items: flex-start; }

.game-title {
  flex: 1;
  margin-right: 10rpx;
  line-height: 1.4;
}

.status-badge {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
  white-space: nowrap;
}

.status-badge.open { background: #E8F5E9; color: #00B96B; }
.status-badge.full { background: #FFF3E0; color: #FF9800; }
.status-badge.done { background: #F5F5F5; color: #9E9E9E; }

.game-info { }

.info-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.info-icon { font-size: 24rpx; }
.info-text { font-size: 26rpx; color: #666666; }

.game-footer { }

.participants-wrap {
  gap: 6rpx;
  flex-wrap: wrap;
}

.participant-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid #FFFFFF;
  margin-right: -10rpx;
  background: #E0E0E0;
}

.participants-count {
  margin-left: 16rpx;
}

.spots-left {
  font-size: 22rpx;
  color: #00B96B;
  background: #E8F5E9;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  font-weight: 600;
}

.fee-wrap {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.fee {
  font-size: 36rpx;
  font-weight: 700;
  color: #F44336;
}

.fee-unit { font-size: 24rpx; }

/* FAB 按钮 */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #00B96B, #00875A);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 185, 107, 0.4);
  z-index: 99;
}

.fab-icon {
  font-size: 60rpx;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
  margin-top: -4rpx;
}

.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx;
}
