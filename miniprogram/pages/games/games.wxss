.games-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F7F8FA;
  position: relative;
}

/* ── Header ── */
.games-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 100rpx 28rpx 20rpx;
  background: #FFFFFF;
}

.gh-title { display: flex; align-items: center; gap: 16rpx; }

.gh-main {
  font-size: 40rpx;
  font-weight: 900;
  color: #1A1A2E;
}

.gh-actions { display: flex; gap: 12rpx; }

.gh-icon-btn {
  width: 72rpx;
  height: 72rpx;
  background: #F7F8FA;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

/* ── Status Tabs ── */
.status-tabs-bar {
  display: flex;
  background: #FFFFFF;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #F2F2F2;
  gap: 8rpx;
}

.stab {
  padding: 20rpx 16rpx;
  font-size: 28rpx;
  color: #888;
  position: relative;
  font-weight: 500;
}

.stab-active {
  color: #1A1A2E;
  font-weight: 800;
}

.stab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 5rpx;
  background: linear-gradient(90deg, #00C27A, #00875A);
  border-radius: 5rpx;
}

/* ── Chips ── */
.chips-bar {
  background: #FFFFFF;
  white-space: nowrap;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #F2F2F2;
}

.chip {
  display: inline-block;
  padding: 10rpx 26rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
  background: #F5F5F5;
  margin-right: 12rpx;
  font-weight: 500;
}

.chip-active {
  background: #1A1A2E;
  color: #FFFFFF;
  font-weight: 700;
}

/* ── Games List ── */
.games-list {
  flex: 1;
  height: 0;
  padding-top: 16rpx;
}

/* ── Event Card ── */
.event-card {
  background: #FFFFFF;
  margin: 0 24rpx 20rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.07);
}

.event-cover {
  height: 180rpx;
  position: relative;
}

.event-cover-inner {
  position: absolute;
  inset: 0;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background: rgba(0,0,0,0.15);
}

.ec-top { align-items: flex-start; }

.ec-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #FFFFFF;
  flex: 1;
  margin-right: 12rpx;
  text-shadow: 0 1rpx 6rpx rgba(0,0,0,0.3);
  line-height: 1.35;
}

.ec-status-chip {
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

.ec-status-chip.OPEN    { background: rgba(0,200,107,0.3); color: #7FFFD4; }
.ec-status-chip.FULL    { background: rgba(255,149,0,0.3); color: #FFD54F; }
.ec-status-chip.COMPLETED { background: rgba(255,255,255,0.2); color: rgba(255,255,255,0.7); }

.ec-level-tag {
  background: rgba(255,255,255,0.2);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  backdrop-filter: blur(4px);
}

.ec-fee {
  font-size: 32rpx;
  font-weight: 900;
  color: #FFE566;
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,0.2);
}

/* ── Event Info ── */
.event-info {
  padding: 18rpx 24rpx 12rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.ei-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.ei-icon { font-size: 24rpx; }

.ei-text {
  font-size: 24rpx;
  color: #666;
}

/* ── Event Footer ── */
.event-footer {
  padding: 16rpx 24rpx 20rpx;
  border-top: 1rpx solid #F5F5F5;
}

.footer-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 3rpx solid #FFFFFF;
  position: relative;
  background: #E0E0E0;
}

.footer-count {
  font-size: 24rpx;
  color: #888;
  margin-left: 16rpx;
}

.spots-pill {
  background: #E6FAF2;
  color: #00B96B;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  margin-left: 10rpx;
}

.footer-action-btn {
  background: linear-gradient(135deg, #00C27A, #00875A);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 14rpx rgba(0,185,107,0.3);
}

.footer-action-btn.btn-disabled {
  background: #F0F0F0;
  color: #AAA;
  box-shadow: none;
}

/* ── FAB ── */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(130rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  background: linear-gradient(135deg, #00C27A, #00875A);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 28rpx rgba(0,185,107,0.45);
  z-index: 99;
}

.fab-plus {
  font-size: 64rpx;
  color: #FFFFFF;
  font-weight: 200;
  line-height: 1;
  margin-top: -4rpx;
}

.loading-center {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx;
}
