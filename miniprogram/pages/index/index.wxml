<view class="home-page">

  <!-- 顶部 Header -->
  <view class="home-hd">
    <view class="hd-greeting">
      <text class="hd-hi">嗨，{{userInfo.nickName}}！👋</text>
      <text class="hd-sub">今天有 {{nearbyGames.length}} 场球局等你</text>
    </view>
    <view class="hd-actions">
      <view class="hd-icon-btn" bindtap="onGoMessages">🔔</view>
      <image class="hd-avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" bindtap="onProfileTap"/>
    </view>
  </view>

  <scroll-view scroll-y class="home-scroll" enable-flex>

    <!-- 大标题 + 筛选 -->
    <view class="page-title-block">
      <view class="pt-row">
        <text class="pt-main">今日球局</text>
        <text class="pt-count">({{nearbyGames.length}})</text>
      </view>
      <text class="pt-sub">找到适合你的球局</text>
    </view>

    <!-- 筛选 pills -->
    <scroll-view scroll-x class="filter-strip">
      <view class="fpill {{feedTab==='recommend'?'fpill-on':''}}" bindtap="onFeedTab" data-tab="recommend">推荐</view>
      <view class="fpill {{feedTab==='latest'?'fpill-on':''}}" bindtap="onFeedTab" data-tab="latest">最新</view>
      <view class="fpill {{feedTab==='nearby'?'fpill-on':''}}" bindtap="onFeedTab" data-tab="nearby">附近</view>
      <view class="fpill {{feedTab==='pro'?'fpill-on':''}}" bindtap="onFeedTab" data-tab="pro">高手局</view>
    </scroll-view>

    <!-- 加载 / 空状态 -->
    <view wx:if="{{loading}}" class="pg-center">
      <text class="pg-tip">加载中...</text>
    </view>
    <view wx:elif="{{nearbyGames.length===0}}" class="pg-center">
      <text class="pg-tip">附近暂无开放球局 🏸</text>
    </view>

    <!-- 球局卡片 -->
    <view wx:else>
      <view
        wx:for="{{nearbyGames}}"
        wx:key="_id"
        class="game-card {{item.cardColor}}"
        bindtap="onGameTap"
        data-id="{{item._id}}"
      >
        <!-- 顶部：等级标签 + 状态 + 加入按钮 -->
        <view class="gc-top">
          <view class="gc-level" style="background:{{item.creator.levelInfo.color}}">
            {{item.minLevel}}~{{item.maxLevel}}
          </view>
          <text class="gc-status">{{item.status==='OPEN'?'招募中':'已满员'}} · {{item.currentPlayers}}/{{item.maxPlayers}}人</text>
          <view
            class="gc-cta {{item.spotsLeft>0?'':'gc-cta-full'}}"
            catchtap="onQuickJoin"
            data-id="{{item._id}}"
            style="opacity:{{joiningId===item._id?0.5:1}}"
          >{{item.spotsLeft>0?'加入 →':'已满'}}</view>
        </view>

        <!-- 大标题 -->
        <text class="gc-title">{{item.title}}</text>

        <!-- 详情行 -->
        <view class="gc-meta">
          <text class="gc-meta-item">📍 {{item.venue}}</text>
          <text class="gc-meta-item">📅 {{item.formattedDate}} {{item.startTime}}</text>
        </view>

        <!-- 底部：创建者 + 价格 -->
        <view class="gc-bottom">
          <view class="gc-creator">
            <image class="gc-cr-av" src="{{item.creator.avatarUrl}}" mode="aspectFill"/>
            <text class="gc-cr-name">{{item.creator.nickName}}</text>
          </view>
          <text class="gc-price">¥{{item.fee}}<text class="gc-price-u">/人</text></text>
        </view>
      </view>
    </view>

    <!-- 活跃球友 section -->
    <view class="section-hd">
      <view class="sh-left">
        <text class="sh-title">活跃球友</text>
        <text class="sh-count">({{nearbyPlayers.length}})</text>
      </view>
      <view class="sh-more" bindtap="onGoFriends">全部 ›</view>
    </view>

    <scroll-view scroll-x class="players-strip">
      <view
        wx:for="{{nearbyPlayers}}"
        wx:key="_id"
        class="player-item"
        bindtap="onPlayerTap"
        data-id="{{item._id}}"
      >
        <view class="pi-av-wrap">
          <image class="pi-av" src="{{item.avatarUrl}}" mode="aspectFill"/>
          <view class="pi-badge" style="background:{{item.levelInfo.color}}">{{item.level}}</view>
        </view>
        <text class="pi-name">{{item.nickName}}</text>
      </view>
    </scroll-view>

    <view class="safe-bottom"></view>
  </scroll-view>

  <!-- 发布 FAB -->
  <view class="fab" bindtap="onCreateGame">
    <text class="fab-plus">+</text>
  </view>

</view>
