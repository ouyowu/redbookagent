.home-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F5F6FF;
}

/* ── Header ── */
.home-hd {
  background: linear-gradient(160deg, #6CCFF0 0%, #4BADD8 100%);
  padding: 88rpx 28rpx 28rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-shrink: 0;
}

.hd-greeting { flex: 1; }

.hd-hi {
  display: block;
  font-size: 40rpx;
  font-weight: 900;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.hd-sub {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}

.hd-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.hd-icon-btn {
  width: 64rpx;
  height: 64rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.hd-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255,255,255,0.6);
  background: #DDD;
}

/* ── Scroll ── */
.home-scroll { flex: 1; height: 0; }

/* ── Page title block ── */
.page-title-block {
  padding: 32rpx 28rpx 12rpx;
  background: #F5F6FF;
}

.pt-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  margin-bottom: 6rpx;
}

.pt-main {
  font-size: 56rpx;
  font-weight: 900;
  color: #0D0D1A;
  line-height: 1.1;
}

.pt-count {
  font-size: 48rpx;
  font-weight: 900;
  color: #4BADD8;
}

.pt-sub {
  font-size: 24rpx;
  color: #888;
}

/* ── Filter strip ── */
.filter-strip {
  white-space: nowrap;
  padding: 0 20rpx 20rpx;
}

.fpill {
  display: inline-block;
  padding: 12rpx 30rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid #DDE0F5;
  background: #FFFFFF;
  margin-right: 12rpx;
}

.fpill-on {
  background: #0D0D1A;
  color: #FFFFFF;
  border-color: #0D0D1A;
  font-weight: 700;
}

/* ── Loading / empty ── */
.pg-center {
  padding: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pg-tip { font-size: 28rpx; color: #AAA; }

/* ── Game card ── */
.game-card {
  margin: 0 20rpx 20rpx;
  border-radius: 28rpx;
  padding: 28rpx 28rpx 24rpx;
}

.game-card.c-lavender { background: #E4E0FF; }
.game-card.c-mint     { background: #C8F7EE; }
.game-card.c-peach    { background: #FFE4D4; }
.game-card.c-yellow   { background: #E8FFB8; }
.game-card.c-blue     { background: #C8E8FF; }

/* Card top */
.gc-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.gc-level {
  font-size: 20rpx;
  font-weight: 900;
  color: #FFFFFF;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.gc-status {
  font-size: 22rpx;
  color: #555;
  flex: 1;
}

.gc-cta {
  background: #0D0D1A;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
  padding: 10rpx 26rpx;
  border-radius: 22rpx;
  flex-shrink: 0;
}

.gc-cta-full {
  background: rgba(0,0,0,0.15);
  color: rgba(0,0,0,0.4);
}

/* Big title */
.gc-title {
  display: block;
  font-size: 44rpx;
  font-weight: 900;
  color: #0D0D1A;
  line-height: 1.25;
  margin-bottom: 16rpx;
}

/* Meta */
.gc-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-bottom: 24rpx;
}

.gc-meta-item {
  font-size: 24rpx;
  color: #555;
  line-height: 1.4;
}

/* Bottom row */
.gc-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.gc-creator {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.gc-cr-av {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.1);
}

.gc-cr-name { font-size: 24rpx; color: #555; }

.gc-price {
  font-size: 40rpx;
  font-weight: 900;
  color: #0D0D1A;
}
.gc-price-u { font-size: 22rpx; font-weight: 500; }

/* ── Section header ── */
.section-hd {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 8rpx 28rpx 16rpx;
}

.sh-left { display: flex; align-items: baseline; gap: 4rpx; }

.sh-title {
  font-size: 44rpx;
  font-weight: 900;
  color: #0D0D1A;
}

.sh-count {
  font-size: 36rpx;
  font-weight: 900;
  color: #4BADD8;
}

.sh-more {
  font-size: 24rpx;
  color: #4BADD8;
  font-weight: 500;
}

/* ── Players strip ── */
.players-strip {
  white-space: nowrap;
  padding: 0 20rpx 32rpx;
}

.player-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin-right: 20rpx;
  vertical-align: top;
}

.pi-av-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
}

.pi-av {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #DDD;
  border: 3rpx solid #FFFFFF;
}

.pi-badge {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  font-size: 16rpx;
  font-weight: 900;
  color: #FFFFFF;
  padding: 3rpx 9rpx;
  border-radius: 12rpx;
  border: 2rpx solid #FFF;
}

.pi-name {
  font-size: 20rpx;
  color: #555;
  max-width: 96rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── FAB ── */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(130rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  background: #0D0D1A;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 28rpx rgba(0,0,0,0.3);
  z-index: 99;
}

.fab-plus {
  font-size: 56rpx;
  color: #FFFFFF;
  font-weight: 200;
  line-height: 1;
  margin-top: -4rpx;
}
