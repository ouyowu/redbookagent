.home-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F0F5FF;
}

/* ── Header ── */
.home-hd {
  background: #FFFFFF;
  padding: 88rpx 28rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #ECEEF8;
  flex-shrink: 0;
}

.hd-logo {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.hd-logo-icon { font-size: 32rpx; }

.hd-logo-text {
  font-size: 32rpx;
  font-weight: 900;
  color: #1A1A2E;
  letter-spacing: 1rpx;
}

.hd-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.hd-btn {
  width: 64rpx;
  height: 64rpx;
  background: #F5F7FF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.hd-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 2rpx solid #ECEEF8;
  background: #E0E0E0;
}

/* ── Feed Tabs ── */
.feed-tabs {
  background: #FFFFFF;
  display: flex;
  padding: 12rpx 20rpx 16rpx;
  gap: 8rpx;
  border-bottom: 1rpx solid #ECEEF8;
  flex-shrink: 0;
}

.ftab {
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #8B8FA8;
  font-weight: 500;
}

.ftab-active {
  background: #1A1A2E;
  color: #FFFFFF;
  font-weight: 700;
}

/* ── Scroll ── */
.home-scroll {
  flex: 1;
  height: 0;
}

/* ── Reels ── */
.reels-section {
  background: #FFFFFF;
  border-bottom: 1rpx solid #ECEEF8;
}

.reels-scroll {
  white-space: nowrap;
  padding: 16rpx 16rpx 20rpx;
}

.reel-item,
.reel-add-wrap {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin-right: 14rpx;
  vertical-align: top;
}

.reel-thumb-wrap {
  width: 80rpx;
  height: 112rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  border: 3rpx solid transparent;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

.reel-thumb {
  width: 100%;
  height: 100%;
}

.reel-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, transparent 40%, rgba(0,0,0,0.55));
}

.reel-bottom {
  position: absolute;
  bottom: 6rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
}

.reel-level {
  font-size: 14rpx;
  font-weight: 900;
  color: #FFFFFF;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
}

.reel-name {
  font-size: 20rpx;
  color: #555;
  max-width: 80rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

.reel-add-thumb {
  width: 80rpx;
  height: 112rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #E8EFFF, #F0F5FF);
  border: 2rpx dashed #00B96B;
  display: flex;
  align-items: center;
  justify-content: center;
}

.reel-add-plus {
  font-size: 44rpx;
  color: #00B96B;
  font-weight: 300;
  line-height: 1;
}

/* ── Post Prompt ── */
.post-prompt {
  background: #FFFFFF;
  margin: 16rpx 16rpx 0;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,60,0.05);
  border: 1rpx solid #ECEEF8;
}

.pp-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #E0E0E0;
  flex-shrink: 0;
}

.pp-input-fake { flex: 1; }

.pp-placeholder {
  font-size: 26rpx;
  color: #C0C4D8;
}

.pp-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
  border-left: 1rpx solid #ECEEF8;
  padding-left: 14rpx;
}

.pp-action-item { font-size: 28rpx; }

/* ── Post Card ── */
.post-card {
  background: #FFFFFF;
  margin: 16rpx 16rpx 0;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0,0,80,0.06);
}

.pcard-hd {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 20rpx 12rpx;
}

.pcard-av-wrap {
  position: relative;
  flex-shrink: 0;
}

.pcard-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #E0E0E0;
}

.pcard-dot-verified {
  position: absolute;
  bottom: 0;
  right: -2rpx;
  width: 24rpx;
  height: 24rpx;
  background: #00B96B;
  border-radius: 50%;
  border: 2rpx solid #FFF;
  color: #FFF;
  font-size: 14rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pcard-meta { flex: 1; }

.pcard-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 4rpx;
}

.pcard-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A2E;
}

.pcard-level-tag {
  font-size: 18rpx;
  font-weight: 800;
  color: #FFFFFF;
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
}

.pcard-time {
  font-size: 22rpx;
  color: #8B8FA8;
}

.pcard-join {
  background: linear-gradient(135deg, #00C27A, #00875A);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  padding: 10rpx 28rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0,185,107,0.3);
}

.pcard-join-full {
  background: #F0F0F0;
  color: #AAA;
  box-shadow: none;
}

/* Cover */
.pcard-cover {
  width: 100%;
  height: 200rpx;
  position: relative;
}

.pcard-cover-inner {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.12);
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.pcc-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.pcc-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #FFFFFF;
  flex: 1;
  margin-right: 12rpx;
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,0.3);
  line-height: 1.35;
}

.pcc-status-chip {
  font-size: 18rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  white-space: nowrap;
}

.pcc-status-chip.OPEN { background: rgba(0,200,107,0.3); color: #7FFFD4; }
.pcc-status-chip.FULL { background: rgba(255,149,0,0.3); color: #FFD54F; }
.pcc-status-chip.COMPLETED { background: rgba(255,255,255,0.2); color: rgba(255,255,255,0.75); }

.pcc-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.pcc-fee {
  font-size: 32rpx;
  font-weight: 900;
  color: #FFE566;
  text-shadow: 0 1rpx 3rpx rgba(0,0,0,0.2);
}

.pcc-fee-unit { font-size: 20rpx; font-weight: 500; }

.pcc-tags { display: flex; gap: 8rpx; }

.pcc-tag {
  background: rgba(255,255,255,0.2);
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

/* Caption */
.pcard-caption {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 20rpx 4rpx;
}

.pcard-caption-text {
  font-size: 24rpx;
  color: #555;
  line-height: 1.5;
  flex: 1;
}

.pcard-spots {
  background: #E6FAF2;
  color: #00B96B;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  margin-left: 8rpx;
}

/* Engagement */
.pcard-eng {
  display: flex;
  align-items: center;
  padding: 14rpx 20rpx 16rpx;
  border-top: 1rpx solid #F5F7FF;
}

.peng-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-right: 32rpx;
}

.peng-bookmark { margin-left: auto; }

.peng-icon { font-size: 28rpx; }

.peng-val {
  font-size: 22rpx;
  color: #8B8FA8;
}

/* ── FAB ── */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(130rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #00C27A, #00875A);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0,185,107,0.4);
  z-index: 99;
}

.fab-plus {
  font-size: 56rpx;
  color: #FFFFFF;
  font-weight: 200;
  line-height: 1;
  margin-top: -4rpx;
}

.loading-center {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx;
}

.color-gray { color: #AAA; }
