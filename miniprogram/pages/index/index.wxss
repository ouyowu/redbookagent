.index-page {
  min-height: 100vh;
  background: #F5F5F5;
}

/* 顶部 header */
.header {
  background: linear-gradient(135deg, #00B96B, #00875A);
  padding: 100rpx 30rpx 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255,255,255,0.5);
  background: #E0E0E0;
}

.user-info { flex: 1; }

.nickname {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 10rpx;
}

.level-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.level-badge {
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.credit-badge {
  font-size: 22rpx;
  background: rgba(255,255,255,0.2);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  color: #FFFFFF;
}

.unverified-tag {
  font-size: 20rpx;
  background: rgba(255,152,0,0.3);
  color: #FFB347;
  padding: 3rpx 12rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255,152,0,0.5);
}

.header-right { }

.location-btn {
  background: rgba(255,255,255,0.2);
  color: #FFFFFF;
  font-size: 24rpx;
  padding: 8rpx 18rpx;
  border-radius: 30rpx;
}

/* 认证提示 */
.verify-banner {
  background: linear-gradient(90deg, #FFF3E0, #FFE0B2);
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  color: #E65100;
}

.verify-banner .arrow {
  font-size: 36rpx;
  color: #FF9800;
}

/* 轮播 */
.banner-swiper {
  height: 200rpx;
  margin: 0 24rpx 20rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.banner-item {
  height: 200rpx;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  gap: 20rpx;
  border-radius: 20rpx;
}

.banner-icon {
  font-size: 70rpx;
}

.banner-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  flex: 1;
}

/* 快捷操作 */
.quick-actions {
  display: flex;
  justify-content: space-around;
  padding: 30rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.action-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.action-icon-wrap.green { background: #E8F5E9; }
.action-icon-wrap.blue { background: #E3F2FD; }
.action-icon-wrap.orange { background: #FFF3E0; }
.action-icon-wrap.purple { background: #F3E5F5; }

.action-label {
  font-size: 22rpx;
  color: #666666;
}

/* 分区 */
.section { margin-top: 10rpx; }

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx 10rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A2E;
}

.section-more {
  font-size: 26rpx;
  color: #00B96B;
}

/* 球局卡片 */
.game-card { cursor: pointer; }

.game-card-header { align-items: flex-start; }

.game-title {
  flex: 1;
  margin-right: 10rpx;
}

.spots-badge {
  background: #E8F5E9;
  color: #00B96B;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  white-space: nowrap;
  font-weight: 600;
}

.full-badge {
  background: #FFF3E0;
  color: #FF9800;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

.game-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.meta-item {
  font-size: 26rpx;
  color: #666666;
}

.game-footer { }

.fee-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #F44336;
}

.creator-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  background: #E0E0E0;
}

.creator-name { }

/* 加载 */
.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
  gap: 16rpx;
}

.loading-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #00B96B;
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}
