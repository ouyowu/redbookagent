<view class="login-page">
  <!-- 背景装饰 -->
  <view class="bg-decoration">
    <view class="circle circle-1"></view>
    <view class="circle circle-2"></view>
    <view class="circle circle-3"></view>
  </view>

  <!-- Logo & 标题 -->
  <view class="logo-section">
    <view class="logo-icon">🏓</view>
    <view class="app-name">匹克约球</view>
    <view class="app-slogan">认证水平 · 信用约球 · 同城社区</view>
  </view>

  <!-- 功能亮点 -->
  <view class="features">
    <view class="feature-item">
      <text class="feature-icon">🎯</text>
      <text class="feature-text">真实水平认证</text>
    </view>
    <view class="feature-item">
      <text class="feature-icon">⭐</text>
      <text class="feature-text">信用评价体系</text>
    </view>
    <view class="feature-item">
      <text class="feature-icon">📍</text>
      <text class="feature-text">同城精准匹配</text>
    </view>
  </view>

  <!-- 登录按钮 -->
  <view class="login-section">
    <button
      class="btn-wx-login"
      loading="{{loading}}"
      bindtap="onWxLogin"
    >
      <text class="wx-icon">💬</text>
      <text>微信一键登录</text>
    </button>

    <!-- 开发调试按钮 -->
    <button class="btn-mock-login" bindtap="onMockLogin">
      开发调试登录（Mock）
    </button>

    <view class="agreement">
      登录即同意
      <text class="link">《用户服务协议》</text>
      和
      <text class="link">《隐私政策》</text>
    </view>
  </view>
</view>
