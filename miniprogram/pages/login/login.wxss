.login-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #5BC4ED;
}

/* ── 上半：天蓝色区域 ── */
.login-top {
  height: 55vh;
  background: linear-gradient(155deg, #7DD6F5 0%, #4BADD8 55%, #3298C8 100%);
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

/* 漂浮装饰 pills */
.pill-deco {
  position: absolute;
  background: rgba(255,255,255,0.22);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  padding: 14rpx 30rpx;
  border-radius: 40rpx;
  border: 1.5rpx solid rgba(255,255,255,0.45);
  letter-spacing: 0.5rpx;
  white-space: nowrap;
}

.pd-1 { top: 12%;  left: 6%;  transform: rotate(-9deg); }
.pd-2 { top: 18%;  right: 8%; transform: rotate(7deg);  }
.pd-3 { top: 44%;  left: 4%;  transform: rotate(-4deg); }
.pd-4 { bottom: 18%; right: 6%;  transform: rotate(11deg); }
.pd-5 { bottom: 28%; left: 22%; transform: rotate(-6deg); }
.pd-6 { top: 60%;  right: 12%; transform: rotate(5deg);  }

/* App 图标盒子 */
.login-icon-box {
  width: 160rpx;
  height: 160rpx;
  background: rgba(255,255,255,0.28);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255,255,255,0.5);
  box-shadow: 0 12rpx 40rpx rgba(0,0,0,0.15);
  z-index: 1;
}

.login-icon-emoji {
  font-size: 80rpx;
  line-height: 1;
}

/* ── 下半：白色面板 ── */
.login-bottom {
  flex: 1;
  background: #FFFFFF;
  border-radius: 48rpx 48rpx 0 0;
  margin-top: -48rpx;
  padding: 56rpx 48rpx calc(40rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 2;
}

.login-hl {
  display: block;
  font-size: 64rpx;
  font-weight: 900;
  color: #1A1A2E;
  line-height: 1.2;
  letter-spacing: 2rpx;
}

.login-sub {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-top: 16rpx;
  margin-bottom: 56rpx;
  letter-spacing: 1rpx;
}

/* 深色主按钮 */
.btn-dark-cta {
  width: 100%;
  height: 100rpx;
  background: #1A1A2E;
  color: #FFFFFF;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 28rpx rgba(26,26,46,0.3);
}
.btn-dark-cta::after { border: none; }

/* 分割线 */
.login-divider {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 32rpx 0;
}
.divider-line { flex: 1; height: 1rpx; background: #EBEBEB; }
.divider-text { font-size: 24rpx; color: #BBB; white-space: nowrap; }

/* 幽灵按钮 */
.btn-ghost-cta {
  width: 100%;
  height: 88rpx;
  background: transparent;
  color: #888;
  border: 2rpx solid #DCDCDC;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: 500;
}
.btn-ghost-cta::after { border: none; }

/* 协议 */
.agreement {
  text-align: center;
  font-size: 22rpx;
  color: #BBBBBB;
  margin-top: auto;
  padding-top: 24rpx;
  line-height: 1.6;
}
.agreement .link { color: #4BADD8; }
