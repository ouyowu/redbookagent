.login-page {
  min-height: 100vh;
  background: linear-gradient(160deg, #E8F5E9 0%, #FFFFFF 50%, #E3F2FD 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 60rpx;
  position: relative;
  overflow: hidden;
}

.bg-decoration {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.15;
}

.circle-1 {
  width: 400rpx;
  height: 400rpx;
  background: #00B96B;
  top: -100rpx;
  right: -100rpx;
}

.circle-2 {
  width: 300rpx;
  height: 300rpx;
  background: #2196F3;
  bottom: 200rpx;
  left: -80rpx;
}

.circle-3 {
  width: 200rpx;
  height: 200rpx;
  background: #FF9800;
  top: 400rpx;
  right: 60rpx;
}

.logo-section {
  margin-top: 200rpx;
  text-align: center;
  z-index: 1;
}

.logo-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
  display: block;
}

.app-name {
  font-size: 60rpx;
  font-weight: 800;
  color: #1A1A2E;
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
}

.app-slogan {
  font-size: 26rpx;
  color: #666666;
  letter-spacing: 2rpx;
}

.features {
  margin-top: 80rpx;
  display: flex;
  gap: 40rpx;
  z-index: 1;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.feature-icon {
  font-size: 48rpx;
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.feature-text {
  font-size: 22rpx;
  color: #666666;
  text-align: center;
}

.login-section {
  width: 100%;
  margin-top: auto;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  z-index: 1;
}

.btn-wx-login {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #07C160, #00875A);
  color: #FFFFFF;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.35);
  letter-spacing: 2rpx;
}

.btn-wx-login::after { border: none; }

.wx-icon {
  font-size: 40rpx;
}

.btn-mock-login {
  width: 100%;
  height: 72rpx;
  background: transparent;
  color: #999999;
  border: 2rpx dashed #DDDDDD;
  border-radius: 50rpx;
  font-size: 26rpx;
  margin-top: 24rpx;
}

.btn-mock-login::after { border: none; }

.agreement {
  text-align: center;
  font-size: 22rpx;
  color: #BBBBBB;
  margin-top: 30rpx;
}

.agreement .link {
  color: #00B96B;
}
