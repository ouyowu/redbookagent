<view class="messages-page">

  <!-- 天蓝色顶部 Header -->
  <view class="msg-hd">
    <text class="msg-hd-title">消息</text>
    <view class="msg-hd-edit">编辑</view>
  </view>

  <!-- 活跃球友横向滚动 -->
  <view class="active-users-section">
    <scroll-view scroll-x class="active-scroll">
      <view
        wx:for="{{activeUsers}}"
        wx:key="_id"
        class="au-item"
        bindtap="onPlayerTap"
        data-id="{{item._id}}"
      >
        <view class="au-ring">
          <image class="au-avatar" src="{{item.avatarUrl}}" mode="aspectFill"/>
          <view class="au-online"></view>
        </view>
        <text class="au-name">{{item.nickName}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 消息列表 -->
  <view wx:if="{{loading}}" class="msg-loading">
    <text class="loading-text">加载中…</text>
  </view>

  <scroll-view wx:else scroll-y class="msg-scroll">

    <!-- 未读消息 -->
    <view wx:if="{{unreadMessages.length > 0}}" class="msg-section">
      <text class="section-label">未读</text>
      <view class="msg-card">
        <view
          wx:for="{{unreadMessages}}"
          wx:key="_id"
          class="msg-row {{index < unreadMessages.length - 1 ? 'has-border' : ''}}"
          bindtap="onMessageTap"
          data-id="{{item._id}}"
          data-type="{{item.type}}"
          data-gameid="{{item.gameId}}"
        >
          <view class="msg-icon-wrap {{item.type}}">
            <text wx:if="{{item.type === 'system'}}">🔔</text>
            <text wx:elif="{{item.type === 'join_request'}}">🙋</text>
            <text wx:elif="{{item.type === 'review'}}">⭐</text>
            <text wx:elif="{{item.type === 'approved'}}">✅</text>
            <text wx:else>💬</text>
          </view>
          <view class="msg-body-wrap">
            <view class="msg-top-row">
              <text class="msg-title">{{item.title}}</text>
              <text class="msg-time">{{item.createdAt}}</text>
            </view>
            <text class="msg-preview">{{item.content}}</text>
          </view>
          <view class="unread-badge">{{item.unreadCount || 1}}</view>
        </view>
      </view>
    </view>

    <!-- 已读 / 全部消息 -->
    <view class="msg-section">
      <text class="section-label">{{unreadMessages.length > 0 ? '已读' : '全部消息'}}</text>
      <view class="msg-card">
        <view
          wx:for="{{readMessages}}"
          wx:key="_id"
          class="msg-row {{index < readMessages.length - 1 ? 'has-border' : ''}}"
          bindtap="onMessageTap"
          data-id="{{item._id}}"
          data-type="{{item.type}}"
          data-gameid="{{item.gameId}}"
        >
          <view class="msg-icon-wrap {{item.type}} muted">
            <text wx:if="{{item.type === 'system'}}">🔔</text>
            <text wx:elif="{{item.type === 'join_request'}}">🙋</text>
            <text wx:elif="{{item.type === 'review'}}">⭐</text>
            <text wx:elif="{{item.type === 'approved'}}">✅</text>
            <text wx:else>💬</text>
          </view>
          <view class="msg-body-wrap">
            <view class="msg-top-row">
              <text class="msg-title muted-title">{{item.title}}</text>
              <text class="msg-time">{{item.createdAt}}</text>
            </view>
            <text class="msg-preview muted-preview">{{item.content}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="safe-bottom"></view>
  </scroll-view>

</view>
