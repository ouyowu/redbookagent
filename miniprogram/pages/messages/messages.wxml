<view class="messages-page">

  <!-- 顶部 Header -->
  <view class="msg-hd">
    <view class="msg-hd-left">
      <text class="msg-hd-title">消息</text>
      <text class="msg-hd-date">{{dateStr}}</text>
    </view>
    <view class="msg-hd-edit">编辑</view>
  </view>

  <!-- 大数字：未读数 -->
  <view wx:if="{{!loading && unreadMessages.length > 0}}" class="unread-hero">
    <text class="uh-num">{{unreadMessages.length}}</text>
    <view class="uh-right">
      <text class="uh-label">条未读消息</text>
      <text class="uh-sub">请及时处理</text>
    </view>
  </view>

  <view wx:elif="{{!loading && unreadMessages.length === 0}}" class="all-read-hero">
    <text class="arh-text">全部已读 ✓</text>
  </view>

  <scroll-view wx:if="{{!loading}}" scroll-y class="msg-scroll">

    <!-- 未读消息 — 色块卡片 -->
    <view wx:if="{{unreadMessages.length > 0}}" class="msg-group">
      <text class="mg-label">未读</text>
      <view
        wx:for="{{unreadMessages}}"
        wx:key="_id"
        class="msg-color-card {{item.cardColor}}"
        bindtap="onMessageTap"
        data-id="{{item._id}}"
        data-type="{{item.type}}"
        data-gameid="{{item.gameId}}"
      >
        <view class="mcc-top">
          <view class="mcc-icon">
            <text wx:if="{{item.type==='system'}}">🔔</text>
            <text wx:elif="{{item.type==='join_request'}}">🙋</text>
            <text wx:elif="{{item.type==='review'}}">⭐</text>
            <text wx:else>✅</text>
          </view>
          <text class="mcc-time">{{item.createdAt}}</text>
        </view>
        <text class="mcc-title">{{item.title}}</text>
        <text class="mcc-body">{{item.content}}</text>
      </view>
    </view>

    <!-- 已读消息 — 白色列表卡 -->
    <view class="msg-group">
      <text class="mg-label">{{unreadMessages.length > 0 ? '已读' : '全部消息'}}</text>
      <view class="read-card">
        <view
          wx:for="{{readMessages}}"
          wx:key="_id"
          class="read-row {{index < readMessages.length - 1 ? 'rr-border' : ''}}"
          bindtap="onMessageTap"
          data-id="{{item._id}}"
          data-type="{{item.type}}"
          data-gameid="{{item.gameId}}"
        >
          <view class="rr-icon {{item.type}}">
            <text wx:if="{{item.type==='system'}}">🔔</text>
            <text wx:elif="{{item.type==='join_request'}}">🙋</text>
            <text wx:elif="{{item.type==='review'}}">⭐</text>
            <text wx:else>✅</text>
          </view>
          <view class="rr-body">
            <view class="rr-top-row">
              <text class="rr-title">{{item.title}}</text>
              <text class="rr-time">{{item.createdAt}}</text>
            </view>
            <text class="rr-preview">{{item.content}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="safe-bottom"></view>
  </scroll-view>

  <view wx:if="{{loading}}" class="msg-loading">
    <text class="loading-tip">加载中…</text>
  </view>

</view>
