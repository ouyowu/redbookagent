.messages-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #EEF6FC;
}

/* ── Header 天蓝色 ── */
.msg-hd {
  background: linear-gradient(160deg, #6CCFF0 0%, #4BADD8 100%);
  padding: 88rpx 32rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}

.msg-hd-title {
  font-size: 44rpx;
  font-weight: 900;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.msg-hd-edit {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  font-weight: 500;
  padding: 8rpx 20rpx;
  background: rgba(255,255,255,0.18);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255,255,255,0.3);
}

/* ── 活跃球友 ── */
.active-users-section {
  background: #FFFFFF;
  border-bottom: 1rpx solid #EEF2F7;
  flex-shrink: 0;
}

.active-scroll {
  white-space: nowrap;
  padding: 20rpx 16rpx 24rpx;
}

.au-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin-right: 20rpx;
  vertical-align: top;
}

.au-ring {
  position: relative;
  width: 88rpx;
  height: 88rpx;
}

.au-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(91,196,237,0.5);
  background: #E0E8F0;
  display: block;
}

.au-online {
  position: absolute;
  bottom: 2rpx;
  right: 2rpx;
  width: 22rpx;
  height: 22rpx;
  background: #22D68A;
  border-radius: 50%;
  border: 3rpx solid #FFFFFF;
}

.au-name {
  font-size: 20rpx;
  color: #555;
  max-width: 88rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

/* ── 消息列表 ── */
.msg-loading {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.loading-text { font-size: 28rpx; color: #AAA; }

.msg-scroll { flex: 1; height: 0; }

.msg-section {
  padding: 24rpx 20rpx 8rpx;
}

.section-label {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: #9AAABB;
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
  padding-left: 4rpx;
}

.msg-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0,80,140,0.07);
}

.msg-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 24rpx;
}

.msg-row.has-border {
  border-bottom: 1rpx solid #F4F7FA;
}

/* Icon wrap */
.msg-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}
.msg-icon-wrap.system       { background: #E3F4FB; }
.msg-icon-wrap.join_request { background: #E8F5E9; }
.msg-icon-wrap.review       { background: #FFF8E1; }
.msg-icon-wrap.approved     { background: #E8F5E9; }
.msg-icon-wrap.muted        { opacity: 0.6; }

/* Body */
.msg-body-wrap {
  flex: 1;
  min-width: 0;
}

.msg-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.msg-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A2E;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 12rpx;
}

.msg-title.muted-title { color: #666; font-weight: 500; }

.msg-time {
  font-size: 20rpx;
  color: #AAB;
  white-space: nowrap;
  flex-shrink: 0;
}

.msg-preview {
  display: block;
  font-size: 24rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.msg-preview.muted-preview { color: #AAA; }

/* Unread badge */
.unread-badge {
  min-width: 40rpx;
  height: 40rpx;
  background: #4BADD8;
  color: #FFFFFF;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
  flex-shrink: 0;
}
