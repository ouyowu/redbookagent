.messages-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F5F6FF;
}

/* ── Header ── */
.msg-hd {
  background: linear-gradient(160deg, #6CCFF0 0%, #4BADD8 100%);
  padding: 88rpx 28rpx 24rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  flex-shrink: 0;
}

.msg-hd-left { flex: 1; }

.msg-hd-title {
  display: block;
  font-size: 52rpx;
  font-weight: 900;
  color: #FFFFFF;
  line-height: 1.1;
  margin-bottom: 6rpx;
}

.msg-hd-date {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}

.msg-hd-edit {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
  padding: 8rpx 20rpx;
  background: rgba(255,255,255,0.18);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255,255,255,0.3);
  flex-shrink: 0;
}

/* ── Unread hero ── */
.unread-hero {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx 28rpx 20rpx;
  background: #F5F6FF;
  flex-shrink: 0;
}

.uh-num {
  font-size: 100rpx;
  font-weight: 900;
  color: #0D0D1A;
  line-height: 1;
}

.uh-right { display: flex; flex-direction: column; gap: 4rpx; }

.uh-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #0D0D1A;
}

.uh-sub {
  font-size: 22rpx;
  color: #888;
}

.all-read-hero {
  padding: 28rpx 28rpx 12rpx;
  flex-shrink: 0;
}

.arh-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #888;
}

/* ── Scroll ── */
.msg-scroll { flex: 1; height: 0; }

.msg-loading { flex: 1; display: flex; align-items: center; justify-content: center; }
.loading-tip { font-size: 28rpx; color: #AAA; }

/* ── Group ── */
.msg-group { padding: 0 20rpx 8rpx; }

.mg-label {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: #9AAABB;
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
  padding-left: 4rpx;
}

/* ── Color cards (unread) ── */
.msg-color-card {
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.msg-color-card.c-lavender { background: #E4E0FF; }
.msg-color-card.c-mint     { background: #C8F7EE; }
.msg-color-card.c-peach    { background: #FFE4D4; }
.msg-color-card.c-yellow   { background: #E8FFB8; }
.msg-color-card.c-blue     { background: #C8E8FF; }

.mcc-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.mcc-icon {
  width: 56rpx;
  height: 56rpx;
  background: rgba(255,255,255,0.55);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.mcc-time {
  font-size: 22rpx;
  color: rgba(0,0,0,0.4);
}

.mcc-title {
  display: block;
  font-size: 32rpx;
  font-weight: 900;
  color: #0D0D1A;
  margin-bottom: 8rpx;
  line-height: 1.25;
}

.mcc-body {
  display: block;
  font-size: 24rpx;
  color: #444;
  line-height: 1.5;
}

/* ── White read card ── */
.read-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0,50,120,0.06);
  margin-bottom: 16rpx;
}

.read-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 20rpx;
}

.read-row.rr-border { border-bottom: 1rpx solid #F2F4FC; }

.rr-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
  opacity: 0.7;
}

.rr-icon.system       { background: #E3F4FB; }
.rr-icon.join_request { background: #E8F5E9; }
.rr-icon.review       { background: #FFF8E1; }
.rr-icon.approved     { background: #E8F5E9; }

.rr-body { flex: 1; min-width: 0; }

.rr-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.rr-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #666;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 10rpx;
}

.rr-time { font-size: 20rpx; color: #BBB; white-space: nowrap; flex-shrink: 0; }

.rr-preview {
  display: block;
  font-size: 22rpx;
  color: #AAA;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
