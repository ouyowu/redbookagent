.player-page { background: #F5F5F5; min-height: 100vh; }

.player-hero {
  background: linear-gradient(135deg, #1A1A2E, #16213E);
  padding: 40rpx 30rpx 50rpx;
}

.player-top-row { gap: 24rpx; margin-bottom: 24rpx; }

.hero-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.3);
  background: #333;
  flex-shrink: 0;
}

.hero-info { }

.hero-name-row { gap: 12rpx; margin-bottom: 16rpx; }

.hero-name {
  font-size: 40rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.verified-tag {
  background: #FFD54F;
  color: #1A1A2E;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.level-display {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  margin-bottom: 10rpx;
}

.level-code {
  font-size: 28rpx;
  font-weight: 900;
  color: #FFFFFF;
}

.level-name {
  font-size: 22rpx;
  color: rgba(255,255,255,0.9);
}

.level-desc {
  display: block;
  opacity: 0.9;
}

.hero-bio {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.7);
  margin-bottom: 30rpx;
  line-height: 1.6;
}

.hero-stats {
  background: rgba(255,255,255,0.1);
  border-radius: 16rpx;
  padding: 20rpx 0;
}

.hero-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.stat-lab {
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
}

/* 信用横幅 */
.credit-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 20rpx 24rpx;
}

.credit-icon { font-size: 40rpx; }

.credit-label {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
}

.credit-score-sm {
  font-size: 36rpx;
  font-weight: 800;
}

/* Tab */
.tab-bar {
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
  margin-top: 10rpx;
}

.tab-item {
  padding: 24rpx 30rpx;
  font-size: 28rpx;
  color: #999999;
  display: inline-block;
  position: relative;
}

.tab-item.active {
  color: #00B96B;
  font-weight: 700;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 30rpx;
  right: 30rpx;
  height: 4rpx;
  background: #00B96B;
  border-radius: 4rpx;
}

/* 评价卡片 */
.review-card { margin: 16rpx 24rpx; }

.reviewer-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: #E0E0E0;
}

.reviewer-name { font-size: 28rpx; display: block; }
.review-date { display: block; margin-top: 4rpx; }

.rating-stars { display: flex; }

.star {
  font-size: 28rpx;
  color: #E0E0E0;
  letter-spacing: 2rpx;
}

.star.filled { color: #FFB300; }

.review-tags { display: flex; flex-wrap: wrap; gap: 10rpx; }

.review-comment {
  display: block;
  line-height: 1.6;
  font-style: italic;
}
