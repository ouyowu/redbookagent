.pp-page {
  background: #F7F8FA;
  min-height: 100vh;
}

/* ── Hero ── */
.pp-hero {
  background: linear-gradient(160deg, #1A1A2E 0%, #16213E 60%, #0F3460 100%);
  padding: 40rpx 32rpx 36rpx;
}

.pp-hero-user {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.pp-avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.pp-ring {
  width: 140rpx;
  height: 140rpx;
  padding: 4rpx;
  border-radius: 50%;
}

.pp-avatar {
  width: 132rpx !important;
  height: 132rpx !important;
  border-radius: 50%;
}

.pp-verified {
  position: absolute;
  bottom: 0;
  right: -8rpx;
  background: #00B96B;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  border: 3rpx solid #1A1A2E;
  white-space: nowrap;
}

.pp-info {
  flex: 1;
  padding-top: 8rpx;
}

.pp-name {
  display: block;
  font-size: 36rpx;
  font-weight: 900;
  color: #FFFFFF;
  margin-bottom: 14rpx;
}

.pp-level-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  margin-bottom: 14rpx;
}

.pp-level-code {
  font-size: 22rpx;
  font-weight: 900;
  color: #FFFFFF;
}

.pp-level-name {
  font-size: 20rpx;
  color: rgba(255,255,255,0.85);
}

.pp-bio {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.55);
  line-height: 1.5;
}

/* Stats */
.pp-stats {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.08);
  border-radius: 20rpx;
  padding: 24rpx 0;
  border: 1rpx solid rgba(255,255,255,0.1);
}

.pp-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.pp-stat-num {
  font-size: 36rpx;
  font-weight: 900;
  color: #FFFFFF;
}

.pp-stat-lab {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
}

.pp-stat-div {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255,255,255,0.15);
}

/* ── Credit Card ── */
.pp-credit-card {
  background: #FFFFFF;
  margin: 20rpx 24rpx;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.ppcc-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.ppcc-emoji { font-size: 40rpx; }

.ppcc-score {
  font-size: 44rpx;
  font-weight: 900;
}

.ppcc-label {
  font-size: 24rpx;
  font-weight: 600;
}

.ppcc-bar-wrap { flex: 1; }

.ppcc-bar-track {
  height: 10rpx;
  background: #F0F0F0;
  border-radius: 10rpx;
  overflow: hidden;
}

.ppcc-bar-fill {
  height: 100%;
  border-radius: 10rpx;
}

/* ── Section Head ── */
.pp-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 24rpx 16rpx;
}

.pp-section-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #1A1A2E;
}

.pp-section-count {
  font-size: 24rpx;
  color: #888;
}

/* ── Review Card ── */
.pp-review-card {
  background: #FFFFFF;
  margin: 0 24rpx 16rpx;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 14rpx rgba(0,0,0,0.05);
}

.pprc-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.pprc-ring {
  width: 72rpx;
  height: 72rpx;
  padding: 3rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.pprc-avatar {
  width: 66rpx !important;
  height: 66rpx !important;
  border-radius: 50%;
}

.pprc-meta { flex: 1; }

.pprc-name {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #1A1A2E;
  margin-bottom: 4rpx;
}

.pprc-date {
  display: block;
  font-size: 20rpx;
  color: #AAA;
}

.pprc-stars { display: flex; gap: 2rpx; }

.pprc-star {
  font-size: 24rpx;
  color: #E0E0E0;
}

.pprc-star-filled { color: #FFB300; }

.pprc-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.pprc-tag {
  background: #F0F8FF;
  color: #667EEA;
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.pprc-comment {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  font-style: italic;
}
