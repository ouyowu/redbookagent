<view class="edit-page">
  <view wx:if="{{isNew}}" class="new-user-banner">
    <text class="banner-text">👋 欢迎加入！请先完善您的球员资料</text>
  </view>

  <scroll-view scroll-y class="form-scroll">
    <!-- 头像 -->
    <view class="avatar-section">
      <button class="avatar-btn" bindtap="onChooseAvatar">
        <image
          class="avatar-preview"
          src="{{form.avatarUrl || '/images/default-avatar.png'}}"
          mode="aspectFill"
        />
        <view class="avatar-edit-mask">
          <text class="camera-icon">📷</text>
          <text class="camera-text">换头像</text>
        </view>
      </button>
    </view>

    <!-- 基础信息 -->
    <view class="form-section">
      <view class="form-item">
        <text class="form-label">昵称 *</text>
        <input
          class="form-input"
          placeholder="输入您的昵称"
          value="{{form.nickName}}"
          bindinput="onInput"
          data-field="nickName"
          maxlength="20"
        />
      </view>

      <view class="form-item">
        <text class="form-label">性别</text>
        <picker range="{{genderOptions}}" value="{{form.gender}}" bindchange="onGenderChange">
          <view class="picker-value">{{genderOptions[form.gender]}}</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">城市</text>
        <input
          class="form-input"
          placeholder="例：上海"
          value="{{form.city}}"
          bindinput="onInput"
          data-field="city"
        />
      </view>

      <view class="form-item">
        <text class="form-label">区域</text>
        <input
          class="form-input"
          placeholder="例：浦东新区"
          value="{{form.district}}"
          bindinput="onInput"
          data-field="district"
        />
      </view>

      <view class="form-item">
        <text class="form-label">个人简介</text>
        <textarea
          class="form-textarea"
          placeholder="介绍一下自己的打球经历、风格..."
          value="{{form.bio}}"
          bindinput="onInput"
          data-field="bio"
          maxlength="100"
          auto-height
        />
      </view>
    </view>

    <view style="height:160rpx"></view>
  </scroll-view>

  <view class="submit-bar">
    <button class="submit-btn" loading="{{submitting}}" bindtap="onSubmit">
      {{isNew ? '完成，开始约球！' : '保存'}}
    </button>
  </view>
</view>
