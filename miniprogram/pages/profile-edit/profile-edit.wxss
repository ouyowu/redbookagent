.edit-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F5F5F5;
}

.new-user-banner {
  background: linear-gradient(90deg, #00B96B, #00875A);
  padding: 20rpx 30rpx;
}

.banner-text {
  font-size: 28rpx;
  color: #FFFFFF;
}

.form-scroll { flex: 1; overflow: hidden; }

.avatar-section {
  background: #FFFFFF;
  padding: 40rpx;
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.avatar-btn {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  padding: 0;
  background: transparent;
  border: none;
  overflow: hidden;
}

.avatar-btn::after { border: none; }

.avatar-preview {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 3rpx solid #E0E0E0;
  background: #F5F5F5;
}

.avatar-edit-mask {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60rpx;
  background: rgba(0,0,0,0.4);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.camera-icon { font-size: 20rpx; }
.camera-text { font-size: 18rpx; color: #FFFFFF; }

.form-section {
  background: #FFFFFF;
  margin-bottom: 20rpx;
  padding: 0 30rpx;
}

.form-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
  display: flex;
  align-items: center;
}

.form-item:last-child { border-bottom: none; }

.form-label {
  font-size: 28rpx;
  color: #333333;
  width: 160rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  text-align: right;
  height: 60rpx;
}

.picker-value {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  text-align: right;
}

.form-textarea {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  min-height: 100rpx;
  line-height: 1.6;
}

.submit-bar {
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #F0F0F0;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #00B96B, #00875A);
  color: #FFFFFF;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 700;
  border: none;
  letter-spacing: 2rpx;
}

.submit-btn::after { border: none; }
