<scroll-view class="profile-page" scroll-y wx:if="{{userInfo}}">

  <!-- ── 顶部问候区 ── -->
  <view class="profile-top">
    <view class="pt-text">
      <text class="pt-hi">嗨，{{userInfo.nickName}}！👋</text>
      <text class="pt-level">{{userInfo.level}} · {{levelInfo.label}} · {{userInfo.city || '北京'}}</text>
    </view>
    <view class="pt-avatar-wrap" bindtap="onGoMembership">
      <image class="pt-avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"/>
      <view wx:if="{{userInfo.levelVerified}}" class="pt-online"></view>
    </view>
  </view>

  <!-- ── 三格统计色块 ── -->
  <view class="stats-row">
    <view class="stat-block stat-blue">
      <text class="sb-num">{{userInfo.gamesPlayed}}</text>
      <text class="sb-lab">参与球局</text>
    </view>
    <view class="stat-block stat-mint">
      <text class="sb-num">{{userInfo.creditScore}}</text>
      <text class="sb-lab">信用分</text>
    </view>
    <view class="stat-block stat-lavender">
      <text class="sb-num">{{userInfo.level}}</text>
      <text class="sb-lab">认证等级</text>
    </view>
  </view>

  <!-- ── 正在运行卡（球员档案入口） ── -->
  <view class="running-card" bindtap="onGoMembership">
    <view class="rc-left">
      <text class="rc-tag">球员档案</text>
      <text class="rc-title">{{userInfo.levelVerified ? '已认证球员 ✓' : '点击完善认证'}}</text>
      <text class="rc-desc">{{levelInfo.desc}}</text>
    </view>
    <view class="rc-right">
      <text class="rc-level">{{userInfo.level}}</text>
      <text class="rc-arrow">→</text>
    </view>
  </view>

  <!-- ── Tab 切换 ── -->
  <view class="profile-tabs">
    <view
      class="ptab {{activeTab==='games'?'ptab-on':''}}"
      bindtap="onTabChange"
      data-tab="games"
    >我的球局 ({{myGames.length}})</view>
    <view
      class="ptab {{activeTab==='credit'?'ptab-on':''}}"
      bindtap="onTabChange"
      data-tab="credit"
    >信用记录</view>
  </view>

  <!-- ── 我的球局 ── -->
  <view wx:if="{{activeTab==='games'}}">
    <view wx:if="{{myGames.length===0}}" class="pg-empty">
      <text class="pg-empty-text">还没参加过球局 🏸</text>
    </view>
    <view wx:else>
      <view
        wx:for="{{myGames}}"
        wx:key="_id"
        class="my-game-card {{item.cardColor}}"
        bindtap="onGameTap"
        data-id="{{item._id}}"
      >
        <view class="mgc-top">
          <view class="mgc-chip {{item.status}}">
            {{item.status==='OPEN'?'招募中':item.status==='COMPLETED'?'已结束':'已满员'}}
          </view>
          <text class="mgc-date">{{item.formattedDate}}</text>
        </view>
        <text class="mgc-title">{{item.title}}</text>
        <text class="mgc-venue">📍 {{item.venue}} · {{item.startTime}}</text>
      </view>
    </view>
  </view>

  <!-- ── 信用记录 ── -->
  <view wx:if="{{activeTab==='credit'}}">

    <!-- 信用分大显示 -->
    <view class="credit-hero">
      <view class="ch-left">
        <text class="ch-label">当前信用分</text>
        <view class="ch-score-row">
          <text class="ch-score" style="color:{{creditLevel.color}}">{{userInfo.creditScore}}</text>
          <view class="ch-tag" style="background:{{creditLevel.color}}25;color:{{creditLevel.color}}">
            {{creditLevel.label}}
          </view>
        </view>
        <view class="ch-bar-track">
          <view class="ch-bar-fill" style="width:{{userInfo.creditScore}}%;background:{{creditLevel.color}}"></view>
        </view>
      </view>
      <text class="ch-emoji">{{creditLevel.icon}}</text>
    </view>

    <!-- 日志 -->
    <view wx:if="{{creditLogs.length===0}}" class="pg-empty">
      <text class="pg-empty-text">暂无信用记录 📊</text>
    </view>
    <view
      wx:else
      wx:for="{{creditLogs}}"
      wx:key="_id"
      class="credit-log-card {{item.change>0?'clc-pos':'clc-neg'}}"
    >
      <view class="clc-icon {{item.change>0?'ci-up':'ci-dn'}}">
        <text>{{item.change>0?'↑':'↓'}}</text>
      </view>
      <view class="clc-body">
        <text class="clc-reason">{{item.reason}}</text>
        <text class="clc-date">{{item.createdAt}}</text>
      </view>
      <text class="clc-delta {{item.change>0?'cd-pos':'cd-neg'}}">
        {{item.change>0?'+':''}}{{item.change}}
      </text>
    </view>
  </view>

  <!-- ── 操作按钮区 ── -->
  <view class="profile-actions">
    <view class="pa-btn pa-video" bindtap="onUploadVideo">🎥 上传认证视频</view>
    <view class="pa-logout" bindtap="onLogout">退出登录</view>
  </view>

  <view class="safe-bottom"></view>
</scroll-view>

<view wx:if="{{!userInfo}}" class="pg-center">
  <text class="pg-tip">加载中…</text>
</view>
