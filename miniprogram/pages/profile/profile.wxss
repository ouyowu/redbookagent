.profile-page {
  background: #F5F6FF;
  height: 100vh;
}

/* ── 顶部问候 ── */
.profile-top {
  background: linear-gradient(160deg, #6CCFF0 0%, #4BADD8 100%);
  padding: 88rpx 28rpx 32rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.pt-text { flex: 1; }

.pt-hi {
  display: block;
  font-size: 44rpx;
  font-weight: 900;
  color: #FFFFFF;
  margin-bottom: 10rpx;
}

.pt-level {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}

.pt-avatar-wrap {
  position: relative;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.pt-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255,255,255,0.7);
  background: #DDD;
}

.pt-online {
  position: absolute;
  bottom: 2rpx;
  right: 2rpx;
  width: 22rpx;
  height: 22rpx;
  background: #22D68A;
  border-radius: 50%;
  border: 2rpx solid #4BADD8;
}

/* ── Stats 色块行 ── */
.stats-row {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 20rpx 8rpx;
}

.stat-block {
  flex: 1;
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.stat-blue     { background: #C8E8FF; }
.stat-mint     { background: #C8F7EE; }
.stat-lavender { background: #E4E0FF; }

.sb-num {
  font-size: 44rpx;
  font-weight: 900;
  color: #0D0D1A;
  line-height: 1;
}

.sb-lab {
  font-size: 20rpx;
  color: #555;
  text-align: center;
}

/* ── Running card ── */
.running-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #0D0D1A;
  margin: 12rpx 20rpx 8rpx;
  border-radius: 24rpx;
  padding: 28rpx 28rpx;
}

.rc-left { flex: 1; }

.rc-tag {
  display: block;
  font-size: 20rpx;
  color: rgba(255,255,255,0.5);
  margin-bottom: 8rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.rc-title {
  display: block;
  font-size: 30rpx;
  font-weight: 900;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.rc-desc {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
  line-height: 1.4;
}

.rc-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding-left: 20rpx;
}

.rc-level {
  font-size: 56rpx;
  font-weight: 900;
  color: #4BADD8;
  line-height: 1;
}

.rc-arrow {
  font-size: 24rpx;
  color: rgba(255,255,255,0.4);
}

/* ── Tabs ── */
.profile-tabs {
  display: flex;
  padding: 16rpx 20rpx 8rpx;
  gap: 12rpx;
}

.ptab {
  padding: 14rpx 32rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid #DDE0F5;
  background: #FFFFFF;
  font-weight: 500;
}

.ptab-on {
  background: #0D0D1A;
  color: #FFFFFF;
  border-color: #0D0D1A;
  font-weight: 700;
}

/* ── My game cards ── */
.my-game-card {
  margin: 0 20rpx 16rpx;
  border-radius: 24rpx;
  padding: 24rpx;
}

.my-game-card.c-lavender { background: #E4E0FF; }
.my-game-card.c-mint     { background: #C8F7EE; }
.my-game-card.c-peach    { background: #FFE4D4; }
.my-game-card.c-yellow   { background: #E8FFB8; }
.my-game-card.c-blue     { background: #C8E8FF; }

.mgc-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.mgc-chip {
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(0,0,0,0.1);
  color: #333;
}

.mgc-chip.OPEN      { background: rgba(0,185,107,0.15); color: #00875A; }
.mgc-chip.FULL      { background: rgba(255,149,0,0.15); color: #C07800; }
.mgc-chip.COMPLETED { background: rgba(0,0,0,0.08); color: #888; }

.mgc-date { font-size: 22rpx; color: #666; }

.mgc-title {
  display: block;
  font-size: 36rpx;
  font-weight: 900;
  color: #0D0D1A;
  margin-bottom: 10rpx;
  line-height: 1.25;
}

.mgc-venue { font-size: 22rpx; color: #555; }

/* ── Credit hero ── */
.credit-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #0D0D1A;
  margin: 0 20rpx 16rpx;
  border-radius: 24rpx;
  padding: 28rpx;
}

.ch-left { flex: 1; }

.ch-label {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
  margin-bottom: 8rpx;
}

.ch-score-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.ch-score {
  font-size: 72rpx;
  font-weight: 900;
  line-height: 1;
}

.ch-tag {
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

.ch-bar-track {
  height: 8rpx;
  background: rgba(255,255,255,0.12);
  border-radius: 8rpx;
  overflow: hidden;
  width: 100%;
}

.ch-bar-fill {
  height: 100%;
  border-radius: 8rpx;
}

.ch-emoji { font-size: 64rpx; }

/* ── Credit log cards ── */
.credit-log-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 0 20rpx 12rpx;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}

.clc-pos { background: #C8F7EE; }
.clc-neg { background: #FFE4D4; }

.clc-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
  flex-shrink: 0;
}

.ci-up { background: rgba(0,185,107,0.2); color: #00875A; }
.ci-dn { background: rgba(255,77,77,0.2); color: #CC3300; }

.clc-body { flex: 1; }

.clc-reason {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #0D0D1A;
  margin-bottom: 4rpx;
}

.clc-date { font-size: 20rpx; color: #888; }

.clc-delta {
  font-size: 36rpx;
  font-weight: 900;
  flex-shrink: 0;
}

.cd-pos { color: #00875A; }
.cd-neg { color: #CC3300; }

/* ── Actions ── */
.profile-actions {
  padding: 24rpx 20rpx 12rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.pa-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}

.pa-video {
  background: #E4E0FF;
  color: #5548C8;
}

.pa-logout {
  text-align: center;
  font-size: 26rpx;
  color: #AAA;
  padding: 16rpx;
}

/* ── Util ── */
.pg-empty { padding: 60rpx 28rpx; }
.pg-empty-text { font-size: 28rpx; color: #AAA; }
.pg-center { height: 100vh; display: flex; align-items: center; justify-content: center; }
.pg-tip { font-size: 28rpx; color: #AAA; }
