.profile-page {
  background: #F7F8FA;
  min-height: 100vh;
}

/* ── Hero ── */
.profile-hero {
  background: linear-gradient(160deg, #6CCFF0 0%, #4BADD8 60%, #2E94C8 100%);
  padding: 80rpx 32rpx 36rpx;
}

.ph-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.ph-action-btn {
  background: rgba(255,255,255,0.12);
  color: rgba(255,255,255,0.9);
  font-size: 24rpx;
  font-weight: 600;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  border: 1rpx solid rgba(255,255,255,0.2);
}

.ph-user {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.ph-avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.ph-ring {
  width: 140rpx;
  height: 140rpx;
  padding: 4rpx;
  border-radius: 50%;
}

.ph-avatar {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
}

.ph-verified {
  position: absolute;
  bottom: 0;
  right: -8rpx;
  background: #00B96B;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  border: 3rpx solid #4BADD8;
  white-space: nowrap;
}

.ph-info {
  flex: 1;
  padding-top: 8rpx;
}

.ph-name {
  display: block;
  font-size: 36rpx;
  font-weight: 900;
  color: #FFFFFF;
  margin-bottom: 14rpx;
}

.ph-level-row { margin-bottom: 14rpx; }

.ph-level-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
}

.ph-level-code {
  font-size: 22rpx;
  font-weight: 900;
  color: #FFFFFF;
}

.ph-level-name {
  font-size: 20rpx;
  font-weight: 600;
  color: rgba(255,255,255,0.85);
}

.ph-bio {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.55);
  line-height: 1.5;
}

/* ── Stats ── */
.ph-stats {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.08);
  border-radius: 20rpx;
  padding: 24rpx 0;
  border: 1rpx solid rgba(255,255,255,0.1);
}

.phs-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.phs-num {
  font-size: 36rpx;
  font-weight: 900;
  color: #FFFFFF;
}

.phs-lab {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
}

.phs-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255,255,255,0.15);
}

/* ── Verify CTA ── */
.verify-cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  margin: 20rpx 24rpx;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.vcta-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.vcta-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #667EEA, #764BA2);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.vcta-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A2E;
  margin-bottom: 6rpx;
}

.vcta-sub {
  display: block;
  font-size: 22rpx;
  color: #888;
}

.vcta-arrow {
  font-size: 40rpx;
  color: #CCC;
  font-weight: 300;
}

/* ── Quick Menu ── */
.profile-menu-row {
  display: flex;
  justify-content: space-around;
  background: #FFFFFF;
  margin: 0 24rpx 20rpx;
  border-radius: 20rpx;
  padding: 28rpx 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.pmenu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.pmenu-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.pmenu-label {
  font-size: 22rpx;
  color: #555;
  font-weight: 500;
}

/* ── Tabs ── */
.profile-tabs {
  display: flex;
  background: #FFFFFF;
  margin: 0 24rpx 16rpx;
  border-radius: 16rpx;
  padding: 8rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.ptab {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  font-size: 26rpx;
  color: #888;
  font-weight: 500;
  border-radius: 12rpx;
}

.ptab-active {
  background: #4BADD8;
  color: #FFFFFF;
  font-weight: 700;
}

/* ── My Games ── */
.my-game-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  margin: 0 24rpx 16rpx;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 2rpx 14rpx rgba(0,0,0,0.05);
}

.mgr-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.mgr-status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.mgr-status-dot.OPEN { background: #00B96B; }
.mgr-status-dot.FULL { background: #FF9500; }
.mgr-status-dot.COMPLETED { background: #AAA; }

.mgr-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A2E;
  margin-bottom: 6rpx;
}

.mgr-date {
  display: block;
  font-size: 22rpx;
  color: #888;
}

.mgr-badge {
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.mgr-badge.OPEN { background: #E6FAF2; color: #00B96B; }
.mgr-badge.FULL { background: #FFF3E0; color: #FF9500; }
.mgr-badge.COMPLETED { background: #F5F5F5; color: #888; }

/* ── Credit Overview ── */
.credit-overview-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  margin: 0 24rpx 16rpx;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 14rpx rgba(0,0,0,0.05);
}

.coc-left { flex: 1; }

.coc-label {
  display: block;
  font-size: 24rpx;
  color: #888;
  margin-bottom: 8rpx;
}

.coc-score {
  font-size: 64rpx;
  font-weight: 900;
  line-height: 1;
}

.coc-level-tag {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-left: 16rpx;
  vertical-align: middle;
}

.credit-bar-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.credit-bar-track {
  flex: 1;
  height: 8rpx;
  background: #F0F0F0;
  border-radius: 8rpx;
  overflow: hidden;
}

.credit-bar-fill {
  height: 100%;
  border-radius: 8rpx;
}

.credit-bar-label {
  font-size: 20rpx;
  color: #AAA;
  flex-shrink: 0;
}

.coc-emoji {
  font-size: 64rpx;
  margin-left: 20rpx;
}

/* ── Credit Log ── */
.credit-log-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #FFFFFF;
  margin: 0 24rpx 12rpx;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
}

.clr-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
  flex-shrink: 0;
}

.clr-pos { background: #E6FAF2; color: #00B96B; }
.clr-neg { background: #FFF0EE; color: #FF4D4F; }

.clr-reason {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 6rpx;
}

.clr-date {
  display: block;
  font-size: 20rpx;
  color: #AAA;
}

.clr-change {
  display: block;
  font-size: 32rpx;
  font-weight: 900;
  text-align: right;
  margin-bottom: 4rpx;
}

.clr-pos-text { color: #00B96B; }
.clr-neg-text { color: #FF4D4F; }

.clr-new {
  display: block;
  font-size: 20rpx;
  color: #AAA;
  text-align: right;
}

/* ── Logout ── */
.logout-wrap {
  padding: 40rpx 24rpx 20rpx;
  display: flex;
  justify-content: center;
}

.logout-btn {
  background: #F5F5F7;
  color: #888;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 80rpx;
  border-radius: 50rpx;
}

.flex-1 { flex: 1; }
.mt-8 { margin-top: 8rpx; }
.align-center { align-items: center; }
.flex { display: flex; }
