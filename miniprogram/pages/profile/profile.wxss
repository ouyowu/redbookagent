.profile-page {
  background: #F5F5F5;
  min-height: 100vh;
}

/* 头部 */
.profile-header {
  background: linear-gradient(135deg, #00B96B, #00875A);
  padding: 80rpx 30rpx 40rpx;
}

.header-actions {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 20rpx;
}

.edit-btn {
  background: rgba(255,255,255,0.25);
  color: #FFFFFF;
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
}

.user-section {
  display: flex;
  gap: 24rpx;
  align-items: flex-start;
  margin-bottom: 40rpx;
}

.avatar-wrap { position: relative; }

.avatar-lg {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.5);
  background: #E0E0E0;
}

.verified-badge {
  position: absolute;
  bottom: -4rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #FFD54F;
  color: #1A1A2E;
  font-size: 18rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  white-space: nowrap;
}

.user-details { flex: 1; }

.user-name {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #FFFFFF;
  margin-bottom: 12rpx;
}

.user-tags { margin-bottom: 12rpx; }

.level-chip {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 700;
  color: #FFFFFF;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.user-bio {
  display: block;
  color: rgba(255,255,255,0.8) !important;
  font-size: 24rpx !important;
}

/* 统计栏 */
.stats-row {
  background: rgba(255,255,255,0.15);
  border-radius: 16rpx;
  display: flex;
  padding: 24rpx 0;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
}

.stat-divider {
  width: 1rpx;
  background: rgba(255,255,255,0.3);
  margin: 8rpx 0;
}

/* 认证提示 */
.verify-prompt {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 24rpx;
  padding: 24rpx;
  border-left: 6rpx solid #FF9800;
}

.verify-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.verify-icon { font-size: 48rpx; }

.verify-title { font-size: 28rpx; display: block; }
.verify-desc { display: block; margin-top: 6rpx; }

.arrow { font-size: 40rpx; }

/* Tab */
.tab-bar {
  display: flex;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
  margin-top: 10rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  font-size: 28rpx;
  color: #999999;
  position: relative;
}

.tab-item.active {
  color: #00B96B;
  font-weight: 700;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #00B96B;
  border-radius: 4rpx;
}

/* 球局列表 */
.game-row { margin: 16rpx 24rpx; }

.game-status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}

.game-status.OPEN { background: #E8F5E9; color: #00B96B; }
.game-status.FULL { background: #FFF3E0; color: #FF9800; }
.game-status.COMPLETED { background: #F5F5F5; color: #9E9E9E; }

/* 信用概览 */
.credit-overview { margin: 16rpx 24rpx; }

.credit-score-num {
  font-size: 72rpx;
  font-weight: 800;
  line-height: 1;
}

.credit-level-label {
  font-size: 26rpx;
  font-weight: 600;
  margin-left: 16rpx;
}

.gauge-icon { font-size: 80rpx; }

/* 信用日志 */
.credit-log { margin: 12rpx 24rpx; }

.log-reason { font-size: 28rpx; color: #333333; }

.log-change {
  font-size: 32rpx;
  font-weight: 700;
}

.log-change.positive { color: #00B96B; }
.log-change.negative { color: #F44336; }

/* 退出登录 */
.logout-section {
  padding: 40rpx 24rpx 20rpx;
}

.logout-btn {
  width: 100%;
  background: #FFFFFF;
  color: #F44336;
  border: 2rpx solid #FFCDD2;
  border-radius: 50rpx;
  font-size: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
}

.logout-btn::after { border: none; }
