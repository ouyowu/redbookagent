.review-page {
  background: #F5F5F5;
  min-height: 100vh;
  padding-top: 20rpx;
}

.card { margin: 0 24rpx 20rpx; }

.section-label { display: block; }

/* 被评价者 */
.reviewee-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: #E0E0E0;
}

/* 星级评分 */
.stars-row {
  display: flex;
  gap: 16rpx;
  justify-content: center;
}

.star-btn {
  font-size: 70rpx;
  color: #E0E0E0;
  transition: color 0.15s;
}

.star-btn.filled { color: #FFB300; }

.rating-label {
  display: block;
  text-align: center;
}

/* 标签 */
.tags-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-chip {
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  background: #F5F5F5;
  color: #666666;
  border: 2rpx solid #EEEEEE;
}

.tag-chip.selected {
  background: #E8F5E9;
  color: #00B96B;
  border-color: #00B96B;
  font-weight: 600;
}

/* 文字评价 */
.comment-input {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
  margin-top: 10rpx;
}

.char-count {
  display: block;
  text-align: right;
  margin-top: 8rpx;
}

/* 信用规则 */
.credit-rule { padding: 20rpx 24rpx; }
.rule-title { display: block; margin-bottom: 12rpx; }
.rule-item { display: block; margin-bottom: 8rpx; line-height: 1.6; }

/* 提交 */
.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #F0F0F0;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #00B96B, #00875A);
  color: #FFFFFF;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 700;
  border: none;
  letter-spacing: 2rpx;
}

.submit-btn::after { border: none; }
