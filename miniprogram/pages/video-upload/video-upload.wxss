.upload-page {
  background: #F5F5F5;
  min-height: 100vh;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 成功 */
.success-page {
  height: 100vh;
  gap: 24rpx;
  padding: 0 60rpx;
  text-align: center;
}

.success-icon { font-size: 120rpx; }
.success-title { font-size: 44rpx; color: #00B96B; }
.success-desc { font-size: 28rpx; line-height: 1.7; }

.back-btn {
  width: 80%;
  margin-top: 20rpx;
}

/* 提示 */
.tips-section { margin: 20rpx 24rpx; }
.tips-title { font-size: 28rpx; }

.tip-row {
  display: flex;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.tip-dot { color: #00B96B; font-weight: 700; flex-shrink: 0; }
.tip-text { line-height: 1.6; }

/* 视频区 */
.video-section { margin: 0 24rpx 20rpx; }

.video-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 300rpx;
  border: 3rpx dashed #DDDDDD;
  border-radius: 16rpx;
  gap: 12rpx;
}

.placeholder-icon { font-size: 70rpx; }
.placeholder-text { font-size: 28rpx; }
.placeholder-sub { font-size: 24rpx; }

.video-player {
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
  background: #000;
}

.re-select { cursor: pointer; }

/* 等级选择 */
.level-section { margin: 0 24rpx 20rpx; }
.section-title { font-size: 28rpx; }

.level-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
  border-radius: 12rpx;
  transition: background 0.2s;
}

.level-row:last-child { border-bottom: none; }

.level-row.selected {
  background: #F0FFF8;
  margin: 0 -16rpx;
  padding: 20rpx 16rpx;
}

.level-code-badge {
  width: 70rpx;
  height: 70rpx;
  background: #1A1A2E;
  border-radius: 16rpx;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.level-label { display: block; font-size: 28rpx; }
.level-desc { display: block; margin-top: 4rpx; }

.check-icon {
  width: 40rpx;
  height: 40rpx;
  background: #00B96B;
  border-radius: 50%;
  color: #FFFFFF;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  flex-shrink: 0;
}

/* 提交 */
.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #F0F0F0;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #00B96B, #00875A);
  color: #FFFFFF;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 700;
  border: none;
  letter-spacing: 2rpx;
}

.submit-btn::after { border: none; }
