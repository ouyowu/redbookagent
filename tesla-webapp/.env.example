# xAI Grok
XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google AI Studio (Gemini)
GOOGLE_AI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Together AI (Hermes)
TOGETHER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ably Realtime (https://ably.com - free tier: 6M msg/month)
ABLY_API_KEY=xxxxxx.yyyyyy:zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz

# Optional: default room ID (overridden per session)
NEXT_PUBLIC_DEFAULT_ROOM=tesla-main

# S3XY Button voice input auth key (put the same value in your iOS Shortcut)
# Leave unset to disable auth (dev only)
TESLA_VOICE_KEY=my-secret-voice-key-change-this

# Optional: OpenAI Whisper for raw audio transcription
# Only needed if you send audio files instead of pre-transcribed text
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
